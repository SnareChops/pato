#!/bin/bash
set -e   # a failed jco/tsc/cargo step must stop the run, not fall through

# Build pato-discord plugin
cd pato-discord
wkg fetch
cargo build --release --target wasm32-wasip2 
cd ..

# Build pato-twitch plugin
cd pato-twitch
wkg fetch
cargo build --release --target wasm32-wasip2 
cd ..

# Build pato-obs plugin
cd pato-obs
wkg fetch
cargo build --release --target wasm32-wasip2 
cd ..

# Build pato-commands plugin
cd pato-commands
wkg fetch
cargo build --release --target wasm32-wasip2 
cd ..

# Build pato-vts plugin
cd pato-vts
wkg fetch
cargo build --release --target wasm32-wasip2 
cd ..

# Copy plugins
mkdir -p src-tauri/plugins/pato_discord_0_1_0
mkdir -p src-tauri/plugins/pato_twitch_0_1_0
mkdir -p src-tauri/plugins/pato_obs_0_1_0
mkdir -p src-tauri/plugins/pato_commands_0_1_0
mkdir -p src-tauri/plugins/pato_vts_0_1_0
cp pato-discord/target/wasm32-wasip2/release/pato_discord.wasm src-tauri/plugins/pato_discord_0_1_0/pato_discord.wasm
cp pato-twitch/target/wasm32-wasip2/release/pato_twitch.wasm src-tauri/plugins/pato_twitch_0_1_0/pato_twitch.wasm
cp pato-obs/target/wasm32-wasip2/release/pato_obs.wasm src-tauri/plugins/pato_obs_0_1_0/pato_obs.wasm
cp pato-commands/target/wasm32-wasip2/release/pato_commands.wasm src-tauri/plugins/pato_commands_0_1_0/pato_commands.wasm
cp pato-vts/target/wasm32-wasip2/release/pato_vts.wasm src-tauri/plugins/pato_vts_0_1_0/pato_vts.wasm

# Fetch 1st-party plugins' public APIs (e.g. pato-obs's `pato:pato-obs/scenes`)
# for the host-side broker - see src-tauri/src/wasm/obs_broker.rs.
cd src-tauri
wkg fetch wit-broker
cd ..

# Build UI
#
# jco is `@bytecodealliance/jco` (install: npm i -g @bytecodealliance/jco).
# Do NOT `npx jco` — the bare name `jco` on npm is a dependency-confusion
# placeholder, not the real tool.
rm -rf src-ui/generated   # jco errors intermittently when overwriting an existing out-dir
jco guest-types src-tauri/wit-internal -n webview -o src-ui/generated
tsc --noEmit -p src-ui
esbuild src-ui/pato.ts --bundle --sourcemap --outfile=src-ui/index.js

# Run application
#
# WebKitGTK's Wayland backend is unreliable on NVIDIA: the DMABUF renderer
# crashes ("Error 71 dispatching to Wayland display"), text-field focus can
# deadlock the web process, and KWin gives the window no titlebar buttons.
# Running under XWayland avoids all three; keep the DMABUF flag as a belt-and-
# braces measure for the NVIDIA driver.
export GDK_BACKEND=x11
export WEBKIT_DISABLE_DMABUF_RENDERER=1
cargo tauri dev --no-watch
