package pato:plugin@0.1.0;

interface init {
  init: func() -> result<bool, string>;
}

interface log {
  info: func(message: string);

  warn: func(message: string);

  error: func(message: string);
}

interface storage {
  get: func(key: string) -> option<string>;

  set: func(key: string, value: string) -> bool;

  del: func(key: string) -> bool;
}

interface database {
  record index {
    name: string,
    key: string,
    unique: bool,
  }

  record store {
    name: string,
    key: string,
    auto: bool,
    indexes: list<index>,
  }

  record bound {
    key: string,
    open: bool,
  }

  variant key-range {
    lower-bound(bound),
    upper-bound(bound),
    between(tuple<bound, bound>),
  }

  variant query {
    key(string),
    keys(list<string>),
    range(key-range),
  }

  /// Schema registration
  register: func(schema: list<store>) -> bool;

  /// Operations
  get: func(store: string, index: option<string>, query: query) -> list<list<tuple<string, string>>>;

  set: func(store: string, data: list<tuple<string, string>>) -> bool;

  get-all: func(store: string) -> list<list<tuple<string, string>>>;

  del: func(store: string, query: query) -> bool;

  count: func(store: string, index: option<string>, query: option<query>) -> u32;
}

/// Shared vocabulary for describing custom-widget UI. These types are pure data:
/// a plugin builds an `element` tree and hands it to the core, which validates
/// it (tag / attr whitelists, url schemes, size limits), scopes every key to the
/// plugin's pid, and forwards a mirrored shape (pato:internal/widget-view) to
/// the webview for rendering. Plugins never touch the DOM; this tree is the only
/// channel. See custom-widgets.md for the full design.
interface widget-dom {
  /// Whitelisted element tags. Deliberately small; grow on demand. Never
  /// script / style / link / meta / iframe / embed / object. `svg`, media
  /// (audio/video) and form-submit semantics are deferred.
  enum tag {
    /// layout / grouping
    div,
    span,
    section,
    header,
    footer,
    nav,
    ul,
    ol,
    li,
    /// text
    p,
    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    strong,
    em,
    small,
    code,
    pre,
    blockquote,
    /// interactive
    button,
    input,
    select,
    %option,
    textarea,
    label,
    a,
    img,
    /// data
    table,
    thead,
    tbody,
    tr,
    th,
    td,
    progress,
    meter,
  }

  enum input-type {
    text,
    number,
    checkbox,
    radio,
  }

  /// Typed, per-tag-whitelisted attributes. The core rejects any attr that is
  /// not valid for the element's tag and validates values: `href` / `src` must
  /// be `https:` or `pato-asset://<pid>/...`; numeric ranges are clamped. No
  /// `on*` handlers here — subscribe to events with `binding`.
  variant attr {
    /// `a`
    href(string),
    /// `img`
    src(string),
    alt(string),
    /// any element
    title(string),
    /// form controls
    name(string),
    placeholder(string),
    value(string),
    /// `input` type=...
    kind(input-type),
    checked(bool),
    disabled(bool),
    /// `textarea`
    rows(u32),
    /// `input` / `progress` / `meter`
    min(f64),
    max(f64),
    step(f64),
  }

  /// --- constrained style vocabulary ----------------------------------------
  /// No raw CSS. Values come from app-level scales so widgets match the theme
  /// and cannot escape their box (no position / z-index / url()).
  enum layout {
    flex-row,
    flex-col,
  }

  enum space {
    none,
    xs,
    sm,
    md,
    lg,
    xl,
  }

  enum text-size {
    xs,
    sm,
    md,
    lg,
    xl,
    xxl,
  }

  /// cross-axis (align-items)
  enum align {
    start,
    center,
    end,
    stretch,
  }

  /// main-axis (justify-content)
  enum justify {
    start,
    center,
    end,
    between,
    around,
  }

  /// Palette slots, resolved to theme CSS variables by the webview; adapt
  /// automatically to light / dark.
  enum theme-color {
    fg,
    fg-muted,
    bg,
    bg-raised,
    border,
    primary,
    success,
    warning,
    danger,
    info,
  }

  variant size {
    /// content-sized
    auto,
    /// 100% of the container axis
    fill,
    /// 0-100
    percent(u32),
    /// a step from the spacing scale
    fixed(space),
  }

  record style {
    layout: option<layout>,
    gap: option<space>,
    padding: option<space>,
    margin: option<space>,
    radius: option<space>,
    color: option<theme-color>,
    background: option<theme-color>,
    font-size: option<text-size>,
    align: option<align>,
    justify: option<justify>,
    grow: option<bool>,
    wrap: option<bool>,
    width: option<size>,
    height: option<size>,
  }

  /// --- events ------------------------------------------------------------
  /// Whitelisted event kinds a plugin may subscribe to on an element.
  enum event-kind {
    click,
    input,
    change,
    submit,
    focus,
    blur,
    enter-key,
  }

  /// Subscribe `handler` (a plugin-chosen opaque id, echoed back on the event)
  /// to `kind` on the owning element.
  record binding {
    kind: event-kind,
    handler: string,
  }

  /// --- tree ------------------------------------------------------------
  ///
  /// WIT forbids recursive types, so the tree is a flat node table
  /// (`custom-widget.nodes`). Every node names its `parent` by index; node 0 is
  /// the root and is the only node with no parent. `parent` must be a lower
  /// index than the node itself, so the table is topologically ordered and
  /// cycles are impossible. Siblings render in ascending table order — the
  /// first child to appear in the table is the first child.
  record element {
    /// Optional reconciliation key. Stable keys preserve DOM identity (focus,
    /// scroll, selection, IME) across re-renders and are required for lists
    /// that reorder. Echoed back as `node-key` on events.
    key: option<string>,
    tag: tag,
    attrs: list<attr>,
    style: option<style>,
    events: list<binding>,
  }

  variant node-kind {
    element(element),
    /// Plain text, rendered via createTextNode — cannot carry markup.
    text(string),
    /// A named slot whose text is updated cheaply via `widgets.set-value`
    /// without re-rendering / diffing the tree (counters, countdowns).
    value-slot(string),
  }

  record node {
    /// Index of this node's parent in `custom-widget.nodes`. `none` only for
    /// node 0 (the root). Must be less than this node's own index.
    parent: option<u32>,
    kind: node-kind,
  }

  /// Widget footprint / grid geometry, in tiles.
  record tile-size {
    w: u32,
    h: u32,
  }
}

interface widgets {
  use widget-dom.{node, tile-size};

  /// --- status-widget (pre-made) ----------------------------------------
  record action {
    id: string,
    text: string,
    description: option<string>,
  }

  record status-widget {
    id: string,
    icon: string,
    label: string,
    tooltip: option<string>,
    actions: list<action>,
  }

  /// --- custom-widget -------------------------------------------------
  /// Full immediate-mode tree, encoded as a flat node table. Sent in its
  /// entirety on every change; the core diffs against the previous tree and
  /// the webview patches the DOM.
  record custom-widget {
    id: string,
    /// flat node table; node 0 is the root. Each node names its parent by
    /// index here; siblings render in table order.
    nodes: list<node>,
  }

  variant widget {
    status-widget(status-widget),
    custom(custom-widget),
  }

  /// Declare a widget and its grid footprint before the first `update`.
  /// `min` / `max` (in tiles) let the user resize it; the plugin must then
  /// design responsively and honour `widget-events.on-layout`. Omitting both
  /// pins the widget to `size`.
  record widget-spec {
    id: string,
    size: tile-size,
    min: option<tile-size>,
    max: option<tile-size>,
  }

  register: func(spec: widget-spec) -> bool;

  /// Push a new state for a widget. For `custom`, `widget` carries the whole
  /// tree.
  update: func(widget: widget) -> bool;

  /// Cheaply set the text of a `value-slot` node without a re-render / diff.
  set-value: func(widget-id: string, slot: string, value: string) -> bool;

  /// Hint that a widget is dirty and should be re-rendered. The core decides
  /// when to apply (debounce, skip while off-screen). Optional — a plugin may
  /// call `update` directly instead.
  request-render: func(widget-id: string);
}

interface widget-events {
  use widget-dom.{event-kind, tile-size};

  /// --- status-widget -------------------------------------------------
  variant status-event {
    clicked,
    action(string),
  }

  /// --- custom-widget ----------------------------------------------
  /// Only whitelisted values, built by the core — never a raw DOM event.
  variant payload {
    /// click / focus / blur / enter-key
    none,
    /// input / change on text|number
    text(string),
    /// change on checkbox|radio
    toggled(bool),
    /// submit: named fields only
    fields(list<tuple<string, string>>),
  }

  record widget-event {
    widget-id: string,
    /// element `key`, or "" if none was set
    node-key: string,
    kind: event-kind,
    payload: payload,
  }

  /// Fired once on mount and again whenever the user resizes the widget on the
  /// grid (within the spec's min / max). Pixel dimensions are intentionally not
  /// provided — design responsively against the tile count.
  record widget-layout {
    widget-id: string,
    tiles: tile-size,
  }

  on-status-event: func(widget-id: string, event: status-event);

  on-event: func(event: widget-event);

  on-layout: func(layout: widget-layout);
}

interface auth {
  open-auth-window: func(title: string, url: string) -> bool;
}

interface auth-events {
  /// Triggered when the OAuth flow is completed / cancelled or otherwise closed
  /// If success is false, the auth flow failed or was cancelled in some way
  on-auth: func(success: bool, response: option<string>) -> result<_, string>;
}

world plugin {
  export init;
}
world logger {
  import log;
}
world ui {
  import widget-dom;
  import widgets;

  export widget-events;
}
world db {
  import database;
}
world store {
  import storage;
}
world host {
  import widget-dom;
  import widgets;

  export init;
  export widget-events;
}
world oauth {
  import auth;

  export auth-events;
}
